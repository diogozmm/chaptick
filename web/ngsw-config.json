{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/i18n/*.json", "/icons/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "content-manifest",
      "urls": ["/content/*/manifest.json"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 5, "maxAge": "365d", "timeout": "3s" }
    },
    {
      "name": "content-chapters",
      "urls": ["/content/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 100, "maxAge": "365d" }
    }
  ]
}
