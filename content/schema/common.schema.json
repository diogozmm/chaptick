{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptick/schema/common.schema.json",
  "$defs": {
    "localized": {
      "description": "User-facing text. English is required; other languages fall back to it.",
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "pt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
