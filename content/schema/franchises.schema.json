{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptick/schema/franchises.schema.json",
  "description": "Franchises shown in the library. A franchise can exist before any of its games has content.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "$ref": "common.schema.json#/$defs/localized" },
      "description": { "$ref": "common.schema.json#/$defs/localized" }
    },
    "additionalProperties": false
  }
}
