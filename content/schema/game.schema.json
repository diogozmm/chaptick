{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptick/schema/game.schema.json",
  "type": "object",
  "required": [
    "id",
    "franchise",
    "name",
    "platforms",
    "dataVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+$"
    },
    "franchise": {
      "type": "string",
      "description": "Id from content/franchises.json."
    },
    "order": {
      "type": "integer",
      "description": "Position inside its franchise in the library (release order)."
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "cover": {
      "description": "Text drawn on the library cover: the game's name split so it reads at a glance. Plain text, never a logo.",
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataVersion": {
      "description": "Bump on every published correction; it busts the offline cache.",
      "type": "integer",
      "minimum": 1
    },
    "trophies": {
      "description": "Trophies/achievements tied to what the app tracks (quests, notes, chests, fish, recipes). Names are the official English ones; descriptions in our own words.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "collection": {
            "description": "Tied to a whole collection screen instead of checklist items.",
            "enum": [
              "fish",
              "recipes"
            ]
          }
        }
      }
    },
    "progressTerm": {
      "description": "What the game is split into for spoiler locking: story chapters, or areas opened in order.",
      "enum": [
        "chapter",
        "area"
      ]
    },
    "gameVersion": {
      "description": "Game patch the content was checked against; drops and prices change between patches.",
      "type": "string"
    }
  },
  "additionalProperties": false
}
