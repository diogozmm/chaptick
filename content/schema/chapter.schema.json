{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaptick/schema/chapter.schema.json",
  "description": "One chapter per file, so the app only ever downloads unlocked chapters.",
  "type": "object",
  "required": [
    "id",
    "gameId",
    "order",
    "neutralLabel",
    "checkpoints",
    "items",
    "itemTexts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+-ch\\d+$"
    },
    "gameId": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "neutralLabel": {
      "description": "\"Prologue\", \"Chapter 1\"... never the real chapter title.",
      "$ref": "common.schema.json#/$defs/localized"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "itemTexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemText"
      }
    },
    "bosses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boss"
      },
      "description": "Guide content: never counted in progress, always shown masked."
    },
    "fish": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fish"
      },
      "description": "Species first catchable in this chapter."
    },
    "fishSpots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fishSpot"
      },
      "description": "Good spots in this chapter's region; they may refer to fish from earlier chapters."
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      },
      "description": "Recipes first obtainable in this chapter."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "description": "Compendium: things first obtainable in this chapter or area, with where to get them here."
    },
    "entrySources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrySource"
      },
      "description": "More ways to get entries from earlier chapters or areas, found only from here on."
    },
    "crafts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/craft"
      },
      "description": "Compendium: things made at a station, first makeable here."
    },
    "creatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creature"
      },
      "description": "Compendium: creatures first met here. Names are always masked."
    },
    "villagers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/villager"
      },
      "description": "Compendium: villagers and how they react to gifts."
    },
    "commonGifts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Gifts most villagers like or find neutral; personal tastes override them.",
      "properties": {
        "likes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "entryId": {
                "type": "string",
                "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            }
          }
        },
        "neutral": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "entryId": {
                "type": "string",
                "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "order",
        "neutralDescription"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-ch\\d+-cp-\\d{2}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "neutralDescription": {
          "$ref": "common.schema.json#/$defs/localized"
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "location",
        "availableUntil",
        "hint",
        "spoilerLevel",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-ch\\d+-(q|hq|mi|co)-\\d{2}$"
        },
        "type": {
          "enum": [
            "quest",
            "hidden_quest",
            "missable",
            "collectible"
          ]
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "location": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "availableUntil": {
          "description": "Checkpoint id after which the item is lost, or null when it never expires.",
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "spoilerLevel": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "sources": {
          "description": "Internal provenance: \"wiki\", \"guide X\", \"verified in game\".",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "steps": {
          "description": "Route through the area, one entry per stop. Progress keys are \"<itemId>#step-<n>\" (1-based), so steps may only be appended once published.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            },
            "additionalProperties": false
          }
        },
        "trophies": {
          "description": "Ids of the game's trophies this item counts toward (game.json `trophies`).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "itemText": {
      "type": "object",
      "required": [
        "itemId",
        "text",
        "author",
        "license",
        "approvedAt"
      ],
      "properties": {
        "itemId": {
          "type": "string"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "const": "CC-BY-SA-4.0"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "boss": {
      "type": "object",
      "required": [
        "id",
        "name",
        "location",
        "strategy",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-ch\\d+-bs-\\d{2}$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "location": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "relatedItem": {
          "type": "string",
          "description": "Quest or missable this fight belongs to, if any."
        },
        "strategy": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "fish": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-ch\\d+-fi-\\d{2}$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "fishSpot": {
      "type": "object",
      "required": [
        "fishId",
        "where"
      ],
      "properties": {
        "fishId": {
          "type": "string"
        },
        "rank": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "description": "Best size rank at this spot, for games that grade catches."
        },
        "where": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "bait": {
          "type": "string",
          "minLength": 1,
          "description": "Bait needed here, for games where bait decides the catch (official item name)."
        }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "source",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-ch\\d+-re-\\d{2}$"
        },
        "kind": {
          "enum": [
            "standard",
            "customized"
          ]
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "Where to get it, or who cooks what for a customized dish."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "where"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "found",
            "shop",
            "loot",
            "random",
            "fish",
            "forage",
            "craft",
            "cook",
            "process",
            "gather",
            "task",
            "drop",
            "other"
          ]
        },
        "where": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "Place, shop or station; in English as the game names it, plus Portuguese."
        },
        "seasons": {
          "type": "array",
          "items": {
            "enum": [
              "spring",
              "summer",
              "autumn",
              "winter"
            ]
          }
        },
        "time": {
          "enum": [
            "day",
            "night"
          ]
        }
      }
    },
    "entrySource": {
      "type": "object",
      "required": [
        "entryId",
        "kind",
        "where"
      ],
      "additionalProperties": false,
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "found",
            "shop",
            "loot",
            "random",
            "fish",
            "forage",
            "craft",
            "cook",
            "process",
            "gather",
            "task",
            "drop",
            "other"
          ]
        },
        "where": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "Place, shop or station; in English as the game names it, plus Portuguese."
        },
        "seasons": {
          "type": "array",
          "items": {
            "enum": [
              "spring",
              "summer",
              "autumn",
              "winter"
            ]
          }
        },
        "time": {
          "enum": [
            "day",
            "night"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "category": {
          "enum": [
            "materials",
            "gems",
            "metals",
            "fish",
            "crops",
            "seeds",
            "food",
            "potions",
            "tools",
            "equipment"
          ]
        },
        "sell": {
          "type": "string",
          "pattern": "^\\d+g$"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "grow": {
          "type": "object",
          "description": "For seeds: when they can be planted and how they grow.",
          "required": [
            "seasons",
            "harvests"
          ],
          "additionalProperties": false,
          "properties": {
            "seasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "spring",
                  "summer",
                  "autumn",
                  "winter"
                ]
              }
            },
            "days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "harvests": {
              "type": "integer",
              "minimum": 1
            },
            "yield": {
              "type": "string"
            },
            "crop": {
              "type": "string",
              "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
            }
          }
        },
        "gear": {
          "type": "object",
          "description": "For equipment: slot, stat changes, bonuses and special effect.",
          "required": [
            "slot"
          ],
          "additionalProperties": false,
          "properties": {
            "slot": {
              "enum": [
                "weapon",
                "offhand",
                "head",
                "body",
                "legs",
                "feet"
              ]
            },
            "stats": {
              "$ref": "common.schema.json#/$defs/localized"
            },
            "bonuses": {
              "$ref": "common.schema.json#/$defs/localized"
            },
            "effect": {
              "$ref": "common.schema.json#/$defs/localized"
            }
          }
        }
      }
    },
    "craft": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "group",
        "ingredients"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "kind": {
          "enum": [
            "craft",
            "cook",
            "forge",
            "process"
          ]
        },
        "group": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "qty"
            ],
            "additionalProperties": false,
            "properties": {
              "entryId": {
                "type": "string",
                "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "qty": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "makes": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
        },
        "unlock": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "success": {
          "type": "string",
          "pattern": "^\\d+%$",
          "description": "Chance the recipe works, when below 100%."
        },
        "yield": {
          "type": "integer",
          "minimum": 2,
          "description": "How many one run makes, when more than one."
        },
        "time": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "How long one run takes."
        }
      }
    },
    "creature": {
      "type": "object",
      "required": [
        "id",
        "name",
        "where",
        "spoilerLevel"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "where": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/localized"
          }
        },
        "spoilerLevel": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "how",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "how": {
                "enum": [
                  "steal",
                  "event",
                  "loot",
                  "victory"
                ],
                "description": "steal: taken in battle; event: given at a fight or meeting; loot: a battle loot pool; victory: what winning that fight can give."
              },
              "items": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "entryId": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                    },
                    "name": {
                      "$ref": "common.schema.json#/$defs/localized"
                    }
                  }
                }
              },
              "chance": {
                "type": "string"
              },
              "variant": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "situation": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "when": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "gives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "entryId": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                    },
                    "name": {
                      "$ref": "common.schema.json#/$defs/localized"
                    }
                  }
                },
                "description": "Items handed over in exchange."
              },
              "pool": {
                "$ref": "common.schema.json#/$defs/localized",
                "description": "The loot pool's name."
              },
              "also": {
                "type": "array",
                "description": "Shared pools this one can also draw from, with their items.",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "items"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "$ref": "common.schema.json#/$defs/localized"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "entryId": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                          },
                          "name": {
                            "$ref": "common.schema.json#/$defs/localized"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/localized",
          "description": "Weak points and the damage it deals."
        }
      }
    },
    "villager": {
      "type": "object",
      "required": [
        "id",
        "name",
        "gifts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/localized"
        },
        "gifts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loves": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "entryId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                  },
                  "name": {
                    "$ref": "common.schema.json#/$defs/localized"
                  }
                }
              }
            },
            "likes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "entryId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                  },
                  "name": {
                    "$ref": "common.schema.json#/$defs/localized"
                  }
                }
              }
            },
            "neutral": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "entryId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                  },
                  "name": {
                    "$ref": "common.schema.json#/$defs/localized"
                  }
                }
              }
            },
            "hates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "entryId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9-]+$"
                  },
                  "name": {
                    "$ref": "common.schema.json#/$defs/localized"
                  }
                }
              }
            }
          }
        },
        "commonOnly": {
          "const": true,
          "description": "Follows only the game's common gift lists, without personal exceptions."
        }
      }
    }
  }
}
